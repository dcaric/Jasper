# Jasper Environment Configuration
# Copy this file to .env and fill in your details.

# Provider: GMAIL, OUTLOOK, or TEAMS
PROVIDER=GMAIL

# Gmail Credentials
GMAIL_USER=your-email@gmail.com
GMAIL_PASS=your-app-password

# Outlook Credentials (for IMAP mode)
OUTLOOK_USER=your-outlook@email.com
OUTLOOK_PASS=your-password

# Teams / Microsoft Graph (Phase 1 read-only)
# Use a delegated user access token with Teams read permissions.
TEAMS_ACCESS_TOKEN=your-microsoft-graph-access-token
# Optional: comma-separated team IDs for channel search in addition to chat search
TEAMS_TEAM_IDS=
# Optional tuning
TEAMS_CHAT_LIMIT=10
TEAMS_MESSAGES_PER_CHAT=20
TEAMS_MESSAGES_PER_CHANNEL=20

# AI Settings
GEMINI_USAGE=1
GEMINI_API_KEY=your-gemini-api-key-for-web-search
USER_NAME=your-windows-username
